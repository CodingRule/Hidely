{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hidely",
  "version": "0.2.1",
  "identifier": "io.github.codingrule.hidely",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hidely",
        "width": 1040,
        "height": 700,
        "minWidth": 700,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}

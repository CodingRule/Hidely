{
  "manifest_version": 3,
  "name": "Hidely for browsers",
  "version": "0.3.0",
  "description": "Keep a browser window out of screen sharing while a private tab is showing. Needs the Hidely app for Windows.",
  "homepage_url": "https://github.com/CodingRule/Hidely",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Hidely",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png"
    }
  }
}
